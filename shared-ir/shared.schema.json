{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:taowind:next-internet:shared:v0.1",
  "title": "TWNI minimal current-profile projections",
  "description": "Ten current runtime object projections, not a universal ontology, signature validator or RCL admission replacement. Signed wrappers remain {body,root,signature}. Validate the selected $defs or this disjoint union.",
  "oneOf": [
    {
      "$ref": "#/$defs/SubjectRef"
    },
    {
      "$ref": "#/$defs/IntentSpec"
    },
    {
      "$ref": "#/$defs/CapabilitySpec"
    },
    {
      "$ref": "#/$defs/AuthorityLease"
    },
    {
      "$ref": "#/$defs/EvidenceEvent"
    },
    {
      "$ref": "#/$defs/WorldRef"
    },
    {
      "$ref": "#/$defs/NodeRef"
    },
    {
      "$ref": "#/$defs/RoutePlan"
    },
    {
      "$ref": "#/$defs/SessionRef"
    },
    {
      "$ref": "#/$defs/ResourceBudget"
    }
  ],
  "$defs": {
    "SubjectRef": {
      "type": "object",
      "properties": {
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "continuityRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "subjectId",
        "continuityRoot"
      ],
      "additionalProperties": false,
      "description": "Stable reference projected from authenticated session/lease. It is not a credential or node locator.",
      "x-runtimeProjection": "{subjectId,continuityRoot} from request.body.session.body"
    },
    "IntentSpec": {
      "type": "object",
      "properties": {
        "capabilityId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "capabilityId",
        "text"
      ],
      "additionalProperties": false,
      "description": "Bounded parsed life intent; signed request separately binds authority, session, route and evidence.",
      "x-runtimeProjection": "src/suite.mjs::parseLifeIntent return value"
    },
    "CapabilitySpec": {
      "type": "object",
      "properties": {
        "capabilityId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "authorityRequired": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "semantics": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "capabilityId",
        "version",
        "inputSchema",
        "outputSchema",
        "authorityRequired",
        "semantics"
      ],
      "additionalProperties": false,
      "x-runtimeProjection": "src/contract.mjs::CAPABILITY; OPP adapter projects this shape to upstream RCP"
    },
    "AuthorityLease": {
      "type": "object",
      "properties": {
        "format": {
          "const": "twni.authority-lease.v0.1"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "continuityRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "worldId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityId": {
          "type": "string",
          "minLength": 1
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notBeforeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "maxRetentionSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxCost": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxLatencyMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxEnergy": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "securityProfile": {
          "const": "ed25519-pinned-local.v1"
        },
        "delegable": {
          "const": false
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "format",
        "leaseId",
        "subjectId",
        "continuityRoot",
        "worldId",
        "capabilityId",
        "scopes",
        "notBeforeMs",
        "expiresAtMs",
        "region",
        "maxRetentionSeconds",
        "maxCost",
        "maxLatencyMs",
        "maxEnergy",
        "securityProfile",
        "delegable",
        "purpose"
      ],
      "additionalProperties": false,
      "description": "The body of the signed local Internet lease. Signature validity and temporal/authority predicates are runtime obligations.",
      "x-runtimeProjection": "suite.lease.body"
    },
    "EvidenceEvent": {
      "type": "object",
      "properties": {
        "format": {
          "const": "twni.evidence.v0.1"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "previousRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "classification": {
          "const": "observed-local"
        },
        "detail": {
          "type": "object"
        },
        "eventRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "format",
        "sequence",
        "previousRoot",
        "type",
        "time",
        "classification",
        "detail",
        "eventRoot"
      ],
      "additionalProperties": false,
      "description": "Existing local ledger event; detail retains domain-owned signed envelopes without redeclaring them. Durable mode adds an authority signature; cryptographic verification remains mandatory in the host.",
      "x-runtimeProjection": "suite.ledger.events[index]"
    },
    "WorldRef": {
      "type": "object",
      "properties": {
        "worldId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "worldId"
      ],
      "additionalProperties": false,
      "description": "Identifier projection only. No RNCS authority, state, resolver or commit follows.",
      "x-runtimeProjection": "{worldId} from authenticated session/lease"
    },
    "NodeRef": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "endpoint": {
          "type": "object",
          "properties": {
            "host": {
              "const": "127.0.0.1"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "transport": {
              "enum": [
                "udp",
                "tcp"
              ]
            }
          },
          "required": [
            "host",
            "port",
            "transport"
          ],
          "additionalProperties": false
        },
        "publicKey": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "nodeId",
        "pid",
        "endpoint",
        "publicKey"
      ],
      "additionalProperties": false,
      "description": "Current local process fixture projection. Keys are public; process ID is observation, not stable identity.",
      "x-runtimeProjection": "fixture.started detail.nodes[index]"
    },
    "RoutePlan": {
      "type": "object",
      "properties": {
        "format": {
          "const": "twni.route-plan.v0.1"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "energy": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bandwidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "backups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true
              },
              "cost": {
                "type": "number",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "latencyMs": {
                "type": "number",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "energy": {
                "type": "number",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "bandwidth": {
                "type": "number",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "cost",
              "latencyMs",
              "energy",
              "bandwidth"
            ],
            "additionalProperties": false
          }
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "maxCost": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxLatencyMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxEnergy": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "routeRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "format",
        "source",
        "target",
        "path",
        "cost",
        "latencyMs",
        "energy",
        "bandwidth",
        "backups",
        "region",
        "maxCost",
        "maxLatencyMs",
        "maxEnergy",
        "routeRoot"
      ],
      "additionalProperties": false,
      "description": "Actual TINP topology search projection. RCL and trusted node state govern final admission.",
      "x-runtimeProjection": "request.body.route / ConstrainedRoutes.plan return value"
    },
    "SessionRef": {
      "type": "object",
      "properties": {
        "format": {
          "const": "twni.session.v0.1"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "continuityRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "worldId": {
          "type": "string",
          "minLength": 1
        },
        "sourceNodeId": {
          "type": "string",
          "minLength": 1
        },
        "targetNodeId": {
          "type": "string",
          "minLength": 1
        },
        "leaseRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedEvidenceRoot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "previousSessionRoot": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "migrationGuard": {
          "type": "object",
          "properties": {
            "programRoot": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "stateRoot": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sourceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "programRoot",
            "stateRoot",
            "sourceSha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "format",
        "sessionId",
        "subjectId",
        "continuityRoot",
        "worldId",
        "sourceNodeId",
        "targetNodeId",
        "leaseRoot",
        "scopes",
        "expiresAtMs",
        "expectedEvidenceRoot",
        "previousSessionRoot"
      ],
      "additionalProperties": false,
      "description": "Signed session body. Migration guard roots appear after an authenticated previous session exists.",
      "x-runtimeProjection": "request.body.session.body"
    },
    "ResourceBudget": {
      "type": "object",
      "properties": {
        "maxCost": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxLatencyMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxEnergy": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxRetentionSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "region": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "maxCost",
        "maxLatencyMs",
        "maxEnergy",
        "maxRetentionSeconds",
        "region"
      ],
      "additionalProperties": false,
      "description": "Only currently enforced/signed lease budget fields; no billing or guaranteed SLA.",
      "x-runtimeProjection": "{maxCost,maxLatencyMs,maxEnergy,maxRetentionSeconds,region} from suite.lease.body"
    }
  }
}
