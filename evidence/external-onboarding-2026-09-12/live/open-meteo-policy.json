{
  "format": "twni.opp-http-readonly-policy.v1",
  "policyId": "open-meteo",
  "adapterVersion": "tinp-opp-http-readonly-v0.1",
  "oppSource": {
    "repository": "https://github.com/xingxuling/OPP",
    "commit": "f7b76582a720d9d18af5153affa0fc2d78bc0410",
    "protocols": [
      "opp.chp.v0.1",
      "opp.rcp.v0.1"
    ]
  },
  "transport": {
    "scheme": "https",
    "method": "GET",
    "allowedHosts": [
      "api.open-meteo.com"
    ],
    "allowedPathPrefixes": [
      "/v1/forecast"
    ],
    "timeoutMs": 12000,
    "maxResponseBytes": 65536,
