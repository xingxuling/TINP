    "credentialPolicy": "none",
    "maxAttempts": 1,
    "allowedRequestHeaders": [
      "accept",
      "user-agent"
    ],
    "responseMediaType": "application/json",
    "responseFields": [
      "latitude",
      "longitude",
      "timezone"
    ]
  },
  "receiptFormat": "twni.opp-http-readonly-receipt.v1",
  "authorityGranted": false,
  "authorityBoundary": "Read-only external observation; no credential, retry, redirect, or authority grant",
